---
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GradualBlur from '../components/GradualBlur/GradualBlur';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  accent?: 'posts' | 'essays';
  ogType?: 'website' | 'article';
  flush?: boolean;
}

const {
  title,
  description = site.description,
  accent = 'posts',
  ogType = 'website',
  flush = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
---

<!doctype html>
<html lang="zh-CN" data-accent={accent} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <!-- 站内链接走客户端换页，顶栏才能 persist，不用每个路由重新挂载。 -->
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#07080d" />
    <script is:inline data-astro-rerun>
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (err) {}
        // 先写到 html 上，避免正文先按黑夜画一帧再跳到白天。
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f8f7f2' : '#07080d');
        root.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('reduce-motion');
        }
      })();
    </script>
    <noscript>
      <style>
        .hero-title .blur-text span {
          opacity: 1 !important;
          filter: none !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Header />
    <main class:list={['site-main', { flush }]}>
      <slot />
    </main>
    <Footer />
    {/* 整页在 window 上滚。target=page 把模糊条固定在视口底部；parent 只认内层滚动容器。 */}
    <GradualBlur
      client:load
      position="bottom"
      height="6rem"
      strength={2}
      layers={8}
      curve="linear"
      exponential
      tint="color-mix(in srgb, var(--color-bg) 60%, transparent)"
      autoHide
      target="page"
      opacity={1}
      saturation={1}
      hoverIntensity={1}
      zIndex={12}
    />
  </body>
</html>
