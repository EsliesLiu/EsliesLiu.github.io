---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteGroup from '../../components/NoteGroup.astro';
import { getPosts, groupByFirstTag, toCard } from '../../lib/content';

const posts = (await getPosts()).map((post) => toCard('posts', post));
const groups = groupByFirstTag(posts);
---

<BaseLayout title="文章" description="Obsidian 里的笔记，按目录分组。">
  <div class="shell">
    <header class="page-header">
      <h1>文章</h1>
      <p>Obsidian 里的笔记，按目录分组。目录里最新的一篇决定这个目录排在前面。</p>
    </header>
    {
      groups.length === 0 ? (
        <p class="empty-copy">还没有公开的文章。</p>
      ) : (
        groups.map(([name, items], index) => (
          <NoteGroup name={name} items={items} panelId={`post-group-${index}`} />
        ))
      )
    }
  </div>
</BaseLayout>
