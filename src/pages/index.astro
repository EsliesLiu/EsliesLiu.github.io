---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop';
import HeroTitle from '../components/HeroTitle';
import GradientText from '../components/GradientText/GradientText';
import SplitFlapText from '../components/SplitFlapText/SplitFlapText';
import ScrollReveal from '../components/ScrollReveal/ScrollReveal';
import AccordionGallery from '../components/AccordionGallery/AccordionGallery';
import { articleHref, getPosts, getRecent } from '../lib/content';
import { site } from '../site';

const published = await getPosts();
// 翻牌按三位机械计数。超过 999 时不再补零。
const countLabel = String(published.length).padStart(3, '0');
const posts = await getRecent();

// 笔记没有封面。用站内色画一块底，避免手风琴去拉外部占位图。
const coverColors = ['#7ee0ff', '#e7b38a', '#8b909a', '#d7f6ff'];
function cover(index: number) {
  const color = coverColors[index % coverColors.length];
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 1200"><rect width="900" height="1200" fill="#101218"/><circle cx="${180 + index * 70}" cy="280" r="240" fill="${color}" fill-opacity="0.42"/><circle cx="680" cy="960" r="300" fill="${color}" fill-opacity="0.16"/></svg>`;
  return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}`;
}

const recentItems = posts.map((post, index) => ({
  image: cover(index),
  label: post.title,
  alt: post.description,
  link: articleHref(post.kind, post.id),
}));
---

<BaseLayout flush>
  <section class="hero">
    <div class="hero-fallback" aria-hidden="true"></div>
    <HeroBackdrop client:idle />
    <div class="shell hero-copy">
      <h1 class="hero-title">
        {/* client:only：不产出 opacity:0 的 SSR 节点。fallback 在 JS 挂上前显示名字。 */}
        <HeroTitle client:only="react" text={site.name}>
          {site.name}
        </HeroTitle>
      </h1>
      <p>
        <GradientText
          client:load
          className="role-text"
          colors={['var(--color-accent)', 'var(--color-accent-soft)', 'var(--color-ink)']}
          animationSpeed={14}
        >
          {site.role}
        </GradientText>
      </p>
      <div class="archive-count">
        <span class="archive-count-label">目前收录</span>
        <SplitFlapText
          client:load
          words={[countLabel]}
          flipDuration={0.12}
          stagger={0.06}
          cycleDelay={2400}
          charset="numeric"
          flipsPerChar={8}
          order="left"
          align="left"
          tileStyle="board"
          tileColor="#111827"
          textColor="#f8fafc"
          glare={0}
          depth={0.5}
          tileRadius={8}
          gap={6}
          fontSize={52}
          loop
          padTo={countLabel.length}
          intro
        />
        <span class="archive-count-unit">篇文章</span>
      </div>
      <p class="hero-actions">
        <a href="/posts/">最近文章</a>
        <a href="/about/">关于</a>
      </p>
    </div>
  </section>
  <section class="scroll-band">
    <div class="shell">
      {/* 中文没有空格，按字拆，滚动时才能逐字淡入。 */}
      <ScrollReveal
        client:load
        text={site.intro}
        containerClassName="scroll-reveal"
        highlightColor=""
        mode="scrub"
        splitBy="chars"
        effect="fade"
        stagger={0.05}
        duration={0.8}
        smoothing={0}
        baseOpacity={0.1}
        baseRotation={3}
        baseOffset={0}
        enableBlur
        blurStrength={4}
      />
    </div>
  </section>
  <section class="recent">
    <div class="shell">
      <div class="section-head">
        <h2>最近更新</h2>
        <a href="/posts/">全部</a>
      </div>
      {
        recentItems.length === 0 ? (
          <p class="empty-copy">还没有公开的文章。</p>
        ) : (
          <AccordionGallery
            client:load
            className="recent-gallery"
            ariaLabel="最近更新"
            items={recentItems}
            defaultIndex={0}
            accentColor="var(--color-accent)"
            overlayColor="var(--color-bg)"
            textColor="var(--color-ink)"
            height={420}
            gap={10}
            radius={16}
            trigger="hover"
            showLabels
            grayscale
          />
        )
      }
    </div>
  </section>
</BaseLayout>
