---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteGroup from '../../components/NoteGroup.astro';
import { getEssays, groupByFirstTag, toCard } from '../../lib/content';

const groups = groupByFirstTag((await getEssays()).map((essay) => toCard('essays', essay)));
---

<BaseLayout title="随笔" description="不写成教程的东西放这里。" accent="essays">
  <div class="shell">
    <header class="page-header">
      <h1>随笔</h1>
      <p>不写成教程的东西放这里。</p>
    </header>
    {
      groups.length === 0 ? (
        <div class="empty">
          <p class="empty-copy">
            还没有公开的随笔。技术笔记在 <a href="/posts/">文章</a> 里。
          </p>
        </div>
      ) : (
        groups.map(([name, items], index) => (
          <NoteGroup name={name} items={items} panelId={`essay-group-${index}`} motion />
        ))
      )
    }
  </div>
</BaseLayout>
