---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { getEssays, toCard } from '../../lib/content';

const essays = (await getEssays()).map((essay) => toCard('essays', essay));
---

<BaseLayout title="随笔" description="不写成教程的东西放这里。" accent="essays">
  <div class="shell">
    <header class="page-header">
      <h1>随笔</h1>
      <p>不写成教程的东西放这里。</p>
    </header>
    <EntryList items={essays}>
      <div slot="empty" class="empty">
        <p class="empty-copy">
          还没有公开的随笔。技术笔记在 <a href="/posts/">文章</a> 里。
        </p>
      </div>
    </EntryList>
  </div>
</BaseLayout>
